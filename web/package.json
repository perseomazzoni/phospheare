{
  "name": "@phospheare/web",
  "version": "0.1.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Perseo Mazzoni",
  "description": "A writing tool. Free and open source, a project open to everyone, not for profit.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.e2e.json && vite build",
    "preview": "vite preview",
    "build:e2e": "vite build --mode e2e --outDir dist/e2e --emptyOutDir",
    "preview:e2e": "vite preview --outDir dist/e2e --strictPort",
    "build:demo": "vite build --mode demo --outDir dist/demo --emptyOutDir && vite build --mode demo --ssr src/demo/prerender.tsx --outDir dist/demo-prerender --emptyOutDir",
    "preview:demo": "vite preview --mode demo --outDir dist/demo --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "export:matrix": "vitest run --config export-matrix.config.ts",
    "shots:landing": "playwright test -c scripts/shots/landing-shots.config.ts",
    "shots:readme": "playwright test -c scripts/shots/readme-shots.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "i18next": "^26.5.7",
    "markdown-it": "^15.0.2",
    "pdfmake": "^0.3.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.5",
    "react-router": "^8.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
