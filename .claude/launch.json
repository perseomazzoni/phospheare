{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "web-e2e-build",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "preview:e2e",
        "--",
        "--port",
        "4180"
      ],
      "port": 4180
    },
    {
      "name": "web-build-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "preview",
        "--",
        "--port",
        "4181",
        "--strictPort"
      ],
      "port": 4181
    },
    {
      "name": "web-demo-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": ["tools/serve-site.mjs", "web/dist/demo", "4182"],
      "port": 4182
    }
  ]
}
