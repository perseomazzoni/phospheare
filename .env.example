# Copy this file to .env (never committed) and fill it in. `npm run dev:full`
# and `npm run dev:identity` read it.
#
# Google sign-in and Remote Storage need a Google Cloud Web client whose
# redirect URI is http://localhost:5173/identity/google/callback
# (docs/install.md, part 2). Paste the secret in an editor, not from
# a shell command, so it stays out of the shell's history.
IDENTITY_GOOGLE_CLIENT_ID=
IDENTITY_GOOGLE_CLIENT_SECRET=

# Optional. These are the defaults; change both together with the redirect
# URI above.
# IDENTITY_PUBLIC_ORIGINS=http://localhost:5173
# IDENTITY_LISTEN=127.0.0.1:47821
